@using FirstUI.DTO

<div class="card h-100 shadow-sm">
    @if (!string.IsNullOrEmpty(Character.ImageUrl))
    {
        <img src="http://localhost:5095@(Character.ImageUrl)" 
             class="card-img-top" 
             alt="@Character.Name" 
             style="height: 180px; object-fit: cover;" />
    }
    else
    {
        <!-- Imagine placeholder dacă personajul nu are poză setată -->
        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
            <span class="text-muted">Fără imagine</span>
        </div>
    }
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="card-title text-primary mb-0">@Character.Name</h5>

            <!-- Butonul transparent cu inimioară -->
            <button class="btn btn-link p-0 text-decoration-none" 
            style="font-size: 1.3rem; line-height: 1;" 
            @onclick="HandleFavoriteClick" 
            title="Adaugă la favorite">
            @(isFavorite ? "❤️" : "🤍")
            </button>
        </div>
        <h6 class="card-subtitle mb-2 text-muted">@Character.PathName • @Character.ElementName</h6>
        
        <p class="card-text mb-1">
            <strong>Rating:</strong> @Character.Rating
        </p>

        @if (Character.Planet != null)
        {
            <p class="card-text text-secondary small">
                <strong>Planetă:</strong> @Character.Planet.Name
            </p>
        }
    </div>
    
    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between pb-3">
        <a href="/edit-character/@Character.Id" class="btn btn-sm btn-outline-primary">
            Editează
        </a>
        <button class="btn btn-sm btn-outline-danger" @onclick="HandleDelete">
            Șterge
        </button>
    </div>
</div>

@code {
    [Parameter] // indica faptul ca acea valoare vine din exterior (de la parinte)
    [EditorRequired] // avertisment daca cineva fol componenta fara un personaj
    public CharacterResponseDTO Character { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnDelete { get; set; } // ! Cardul nu apeleaza direct API-ul de stergere deoarece nu are valoriloe
                                                    // din home.razor, EventCallback anunta pagina parinte ca s-a cerut stergerea caracterului
                                                    // iar in home.razor ondelete va apela task-ul delete character

    private async Task HandleDelete()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Character.Id); // declanseaza event-ul si trimite ID-ul catre metoda din parinte
        }
    } // OBS! Folderu de componente trb declarat in _imports pt a putea fi folosit in orice pagina

    [Parameter]
    public bool isFavorite {get; set;}

    [Parameter]
    public EventCallback<int> OnToggleFavorite {get; set;}

    private async Task HandleFavoriteClick() {
        if (OnToggleFavorite.HasDelegate) {
            await OnToggleFavorite.InvokeAsync(Character.Id); // trimite la pagina parinte (home) sa se activeze togglefavorite
        }
    }
} 