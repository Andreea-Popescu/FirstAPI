@page "/edit-aeon/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Editează Aeon</h3>

@if (isLoading)
{
    <p>Se încarcă datele...</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="AeonModel" OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Câmpul Nume -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Nume:</label>
            <InputText class="form-control" @bind-Value="AeonModel.Name" />
        </div>

        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Description:</label>
            <InputText class="form-control" @bind-Value="AeonModel.Description" />
        </div>

        <!-- Dropdown path -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Path:</label>
            <InputSelect class="form-control" @bind-Value="AeonModel.PathId">
                <option value="0">-- Alege un path --</option>
                @if (paths != null)
                {
                    @foreach (var p in paths)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                }
            </InputSelect>
        </div>

                <!-- Câmpul Imagine -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Imagine Personaj:</label>
            <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
            
            @if (isUploading)
            {
                <p class="text-muted small mt-1">Se încarcă imaginea...</p>
            }
            @if (!string.IsNullOrEmpty(AeonModel.ImageUrl))
            {
                <div class="mt-2">
                    <img src="http://localhost:5095@(AeonModel.ImageUrl)" 
                         alt="Preview" 
                         style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            }
        </div>


        <button type="submit" class="btn btn-success">Salvează Modificările</button>
        <a href="/" class="btn btn-secondary ms-2">Anulează</a>
    </EditForm>
}




@code {
    [Parameter]
    public int Id { get; set; } 
    private CreateAeonDTO AeonModel = new();
    private List <PathDTO>? paths;
    private bool isLoading = true;
    private bool isUploading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            paths = await Http.GetFromJsonAsync<List<PathDTO>>("http://localhost:5095/api/aeon/paths");


            var existingAeon = await Http.GetFromJsonAsync<CreateAeonDTO>($"http://localhost:5095/api/aeon/{Id}");

            if (existingAeon != null)
            {
                AeonModel = existingAeon;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploading = true;

        try
        {
            var maxAllowedSize = 5 * 1024 * 1024;
            using var stream = file.OpenReadStream(maxAllowedSize);
            
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("http://localhost:5095/api/upload/aeon-image", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    AeonModel.ImageUrl = result.Url;
                }
            }
            else
            {
                errorMessage = "Eroare la încărcarea imaginii pe server.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare fișier: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleUpdate()
    {
 
        var response = await Http.PutAsJsonAsync($"http://localhost:5095/api/aeon/{Id}", AeonModel);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/aeons");
        }
        else
        {
            errorMessage = "A apărut o problemă la actualizarea personajului.";
        }
    }
}