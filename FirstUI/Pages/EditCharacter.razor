@page "/edit-character/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Editează Personajul</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (isLoading)
{
    <p>Se încarcă datele...</p>
}
else
{
    <EditForm Model="characterModel" OnValidSubmit="HandleUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Câmpul Nume -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Nume:</label>
            <InputText class="form-control" @bind-Value="characterModel.Name" />
        </div>

        <!-- Câmpul Rating -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Rating:</label>
            <InputNumber class="form-control" @bind-Value="characterModel.Rating" />
        </div>

        <!-- Dropdown Planetă -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Planetă:</label>
            <InputSelect class="form-control" @bind-Value="characterModel.PlanetId">
                <option value="0">-- Alege o planetă --</option>
                @if (planets != null)
                {
                    @foreach (var p in planets)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                }
            </InputSelect>
        </div>

        <!-- Dropdown Element -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Element:</label>
            <InputSelect class="form-control" @bind-Value="characterModel.ElementId">
                <option value="0">-- Alege un element --</option>
                @if (elements != null)
                {
                    @foreach (var el in elements)
                    {
                        <option value="@el.Id">@el.Name</option>
                    }
                }
            </InputSelect>
        </div>

        <!-- Dropdown Path -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Path:</label>
            <InputSelect class="form-control" @bind-Value="characterModel.PathId">
                <option value="0">-- Alege un path --</option>
                @if (paths != null)
                {
                    @foreach (var ph in paths)
                    {
                        <option value="@ph.Id">@ph.Name</option>
                    }
                }
            </InputSelect>
        </div>

        <!-- Câmpul Imagine -->
        <div class="mb-3" style="max-width: 320px;">
            <label class="form-label">Imagine Personaj:</label>
            <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
            
            @if (isUploading)
            {
                <p class="text-muted small mt-1">Se încarcă imaginea...</p>
            }
            @if (!string.IsNullOrEmpty(characterModel.ImageUrl))
            {
                <div class="mt-2">
                    <img src="http://localhost:5095@(characterModel.ImageUrl)" 
                         alt="Preview" 
                         style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            }
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Salvează Modificările</button>
            <a href="/" class="btn btn-secondary ms-2">Anulează</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CreateCharacterDTO characterModel = new();
    private List<PlanetDTO>? planets;
    private List<ElementDTO>? elements;
    private List<PathDTO>? paths;
    
    private bool isLoading = true;
    private bool isUploading = false;
    private string? errorMessage;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploading = true;

        try
        {
            var maxAllowedSize = 5 * 1024 * 1024;
            using var stream = file.OpenReadStream(maxAllowedSize);
            
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("http://localhost:5095/api/upload/character-image", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    characterModel.ImageUrl = result.Url;
                }
            }
            else
            {
                errorMessage = "Eroare la încărcarea imaginii pe server.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare fișier: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            planets = await Http.GetFromJsonAsync<List<PlanetDTO>>("http://localhost:5095/api/character/planets");
            elements = await Http.GetFromJsonAsync<List<ElementDTO>>("http://localhost:5095/api/character/elements");
            paths = await Http.GetFromJsonAsync<List<PathDTO>>("http://localhost:5095/api/lightcone/paths");

            var existingCharacter = await Http.GetFromJsonAsync<CreateCharacterDTO>($"http://localhost:5095/api/character/{Id}");

            if (existingCharacter != null)
            {
                characterModel = existingCharacter;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Eroare: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        var response = await Http.PutAsJsonAsync($"http://localhost:5095/api/character/{Id}", characterModel);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = "A apărut o problemă la actualizarea personajului.";
        }
    }
}