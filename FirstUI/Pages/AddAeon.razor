@page "/add-aeon"
@using FirstUI.DTO
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Adaugă un Aeon</PageTitle>

<h2>Adaugă un Aeon Nou</h2>

<EditForm Model="@newAeon" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Nume:</label>
        <InputText class="form-control" @bind-Value="newAeon.Name" />
    </div>

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Description:</label>
        <InputText class="form-control" @bind-Value="newAeon.Description" />
    </div>

    <div style="margin-bottom: 16px; max-width: 320px;">
        <label>Path:</label>
        <InputSelect class="form-control" @bind-Value="newAeon.PathId">
            <option value="0">-- Alege un path --</option>
            @if (path != null)
            {
                @foreach (var p in path)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3" style="max-width: 320px;">
    <label class="form-label">Imagine Personaj:</label>
    <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
    
    @if (isUploading)
    {
        <p class="text-muted small mt-1">Se încarcă imaginea...</p>
    }
    @if (!string.IsNullOrEmpty(newAeon.ImageUrl))
    {
        <div class="mt-2">
            <img src="http://localhost:5095@(newAeon.ImageUrl)" 
                 alt="Preview" 
                 style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
        </div>
    }
</div>

    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; cursor: pointer;">
        Salvează Aeon
    </button>
</EditForm>

@code {
    private CreateAeonDTO newAeon = new();
    private List <PathDTO>? path;
    
    private bool isUploading = false;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            path = await Http.GetFromJsonAsync<List<PathDTO>>("http://localhost:5095/api/aeon/paths");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5095/api/aeon", newAeon);

            if (response.IsSuccessStatusCode)
            {
                // Redirecționează utilizatorul înapoi pe pagina principală pentru a vedea cardul nou
                Navigation.NavigateTo("/aeons");
            }
            else
            {
                Console.WriteLine("Eroare la salvare în API.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare HTTP: {ex.Message}");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
    var file = e.File;
    if (file == null) return;

    isUploading = true;

    try
    {
        // Limităm dimensiunea fișierului citit în memorie (ex: max 5 MB)
        var maxAllowedSize = 5 * 1024 * 1024;
        using var stream = file.OpenReadStream(maxAllowedSize);
        
        // Pregătim pachetul multipart/form-data
        using var content = new MultipartFormDataContent();
        using var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        content.Add(fileContent, "file", file.Name);

        // Trimitem la API-ul de upload
        var response = await Http.PostAsync("http://localhost:5095/api/upload/aeon-image", content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<UploadResult>();
            if (result != null)
            {
                // Salvăm URL-ul în DTO-ul personajului
                newAeon.ImageUrl = result.Url;
            }
        }
        else
        {
            errorMessage = "Eroare la încărcarea imaginii pe server.";
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Eroare fișier: {ex.Message}";
    }
    finally
    {
        isUploading = false;
    }
}
}