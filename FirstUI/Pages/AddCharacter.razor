@page "/add-character"
@using FirstUI.DTO
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Adaugă Personaj</PageTitle>

<h2>Adaugă un Personaj Nou</h2>

<EditForm Model="@newCharacter" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Nume:</label>
        <InputText class="form-control" @bind-Value="newCharacter.Name" />
    </div>

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Rating (1 - 100):</label>
        <InputNumber class="form-control" @bind-Value="newCharacter.Rating" />
    </div>

    <div style="margin-bottom: 16px; max-width: 320px;">
        <label>Planetă:</label>
        <InputSelect class="form-control" @bind-Value="newCharacter.PlanetId">
            <option value="0">-- Alege o planetă --</option>
            @if (planets != null)
            {
                @foreach (var p in planets)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            }
        </InputSelect>
    </div>

    <div style="margin-bottom: 16px; max-width: 320px;">
    <label>Element:</label>
    <InputSelect class="form-control" @bind-Value="newCharacter.ElementId">
        <option value="0">-- Alege un element --</option>
        @if (elements != null)
        {
            @foreach (var el in elements)
            {
                <option value="@el.Id">@el.Name</option>
            }
        }
    </InputSelect>
</div>

    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; cursor: pointer;">
        Salvează Personaj
    </button>
</EditForm>

@code {
    private CreateCharacterDTO newCharacter = new();
    private List<PlanetDTO>? planets;
    private List<ElementDTO>? elements;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Portul HTTP al API-ului tău (5095)
            planets = await Http.GetFromJsonAsync<List<PlanetDTO>>("http://localhost:5095/api/character/planets");
            elements = await Http.GetFromJsonAsync<List<ElementDTO>>(requestUri: "http://localhost:5095/api/character/elements");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5095/api/character", newCharacter);

            if (response.IsSuccessStatusCode)
            {
                // Redirecționează utilizatorul înapoi pe pagina principală pentru a vedea cardul nou
                Navigation.NavigateTo("/");
            }
            else
            {
                Console.WriteLine("Eroare la salvare în API.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare HTTP: {ex.Message}");
        }
    }
}