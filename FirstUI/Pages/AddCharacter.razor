@page "/add-character"
@using FirstUI.DTO
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Adaugă Personaj</PageTitle>

<h2>Adaugă un Personaj Nou</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<EditForm Model="@newCharacter" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Nume:</label>
        <InputText class="form-control" @bind-Value="newCharacter.Name" />
    </div>

    <div style="margin-bottom: 12px; max-width: 320px;">
        <label>Rating (1 - 100):</label>
        <InputNumber class="form-control" @bind-Value="newCharacter.Rating" />
    </div>

    <div style="margin-bottom: 16px; max-width: 320px;">
        <label>Planetă:</label>
        <InputSelect class="form-control" @bind-Value="newCharacter.PlanetId">
            <option value="0">-- Alege o planetă --</option>
            @if (planets != null)
            {
                @foreach (var p in planets)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            }
        </InputSelect>
    </div>

    <div style="margin-bottom: 16px; max-width: 320px;">
    <label>Element:</label>
    <InputSelect class="form-control" @bind-Value="newCharacter.ElementId">
        <option value="0">-- Alege un element --</option>
        @if (elements != null)
        {
            @foreach (var el in elements)
            {
                <option value="@el.Id">@el.Name</option>
            }
        }
    </InputSelect>
</div>

    <div style="margin-bottom: 16px; max-width: 320px;">
    <label>Path:</label>
    <InputSelect class="form-control" @bind-Value="newCharacter.PathId">
        <option value="0">-- Alege un path --</option>
        @if (paths != null)
        {
            @foreach (var ph in paths)
            {
                <option value="@ph.Id">@ph.Name</option>
            }
        }
    </InputSelect>
</div>

    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; cursor: pointer;">
        Salvează Personaj
    </button>

    <!-- În interiorul <EditForm>, deasupra butonului de submit -->
<div class="mb-3" style="max-width: 320px;">
    <label class="form-label">Imagine Personaj:</label>
    <InputFile class="form-control" OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp" />
    
    @if (isUploading)
    {
        <p class="text-muted small mt-1">Se încarcă imaginea...</p>
    }
    @if (!string.IsNullOrEmpty(newCharacter.ImageUrl))
    {
        <div class="mt-2">
            <img src="http://localhost:5095@(newCharacter.ImageUrl)" 
                 alt="Preview" 
                 style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #ddd;" />
        </div>
    }
</div>
</EditForm>

@code {
    private CreateCharacterDTO newCharacter = new();
    private List<PlanetDTO>? planets;
    private List<ElementDTO>? elements;
    
    private List <PathDTO>? paths;

    private bool isUploading = false;

    private string? errorMessage;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
    var file = e.File;
    if (file == null) return;

    isUploading = true;

    try
    {
        // Limităm dimensiunea fișierului citit în memorie (ex: max 5 MB)
        var maxAllowedSize = 5 * 1024 * 1024;
        using var stream = file.OpenReadStream(maxAllowedSize);
        
        // Pregătim pachetul multipart/form-data
        using var content = new MultipartFormDataContent();
        using var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        content.Add(fileContent, "file", file.Name);

        // Trimitem la API-ul de upload
        var response = await Http.PostAsync("http://localhost:5095/api/upload/character-image", content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<UploadResult>();
            if (result != null)
            {
                // Salvăm URL-ul în DTO-ul personajului
                newCharacter.ImageUrl = result.Url;
            }
        }
        else
        {
            errorMessage = "Eroare la încărcarea imaginii pe server.";
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Eroare fișier: {ex.Message}";
    }
    finally
    {
        isUploading = false;
    }
}


    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Portul HTTP al API-ului tău (5095)
            planets = await Http.GetFromJsonAsync<List<PlanetDTO>>("http://localhost:5095/api/character/planets");
            elements = await Http.GetFromJsonAsync<List<ElementDTO>>(requestUri: "http://localhost:5095/api/character/elements");
            paths = await Http.GetFromJsonAsync<List<PathDTO>>("http://localhost:5095/api/lightcone/paths");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare: {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5095/api/character", newCharacter);

            if (response.IsSuccessStatusCode)
            {
                // Redirecționează utilizatorul înapoi pe pagina principală pentru a vedea cardul nou
                Navigation.NavigateTo("/");
            }
            else
            {
                Console.WriteLine("Eroare la salvare în API.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare HTTP: {ex.Message}");
        }
    }
}