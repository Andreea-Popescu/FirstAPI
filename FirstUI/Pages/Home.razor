@page "/"
@inject HttpClient Http

<PageTitle>Welcome to HSR!</PageTitle>

<h1>Hello, world!</h1>

@if (characters == null)
{
    <p><em>Se încarcă datele...</em></p>
}
else
{
    <div style="display: flex; gap: 16px; flex-wrap: wrap; margin-top: 20px;">
        @foreach (var c in characters)
        {
            <div style="border: 1px solid #ddd; border-radius: 10px; padding: 16px; width: 220px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); background-color: #fff;">
                <h3 style="margin-top: 0;">@c.Name</h3> // se pune cu arond pt ca extrag datele din obiect si le lipesc dir in text
                <p><strong>Rating:</strong> ⭐ @c.Rating / 100</p>
                <hr style="border: 0; border-top: 1px solid #eee;" />
                <p style="margin-bottom: 4px;"><strong>Planetă:</strong> @(c.Planet?.Name ?? "Necunoscută")</p>
                <small style="color: #666;">@(c.Planet?.Description ?? "Fără descriere")</small> // ce e dupa ?? e filler pt valori lipsa
            </div>
        }
    </div>
}

@code {
    private List<CharacterResponseDTO>? characters; // ? pt ca la inceput e goala

    protected override async Task OnInitializedAsync() // THIS ONE IDK
    {
        try
        {
            // Schimbă 7000 cu portul exact afișat în terminal când pornești FirstAPI
            characters = await Http.GetFromJsonAsync<List<CharacterResponseDTO>>("http://localhost:5095/api/character"); // AICI APELAM RUTA SPECIFICA PT ACEL GET CU API/CHARACTER
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare la apel API: {ex.Message}");
        }
    }
}