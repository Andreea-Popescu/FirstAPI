@page "/lightcones"
@inject HttpClient Http

<PageTitle>Lightcones!</PageTitle>

<h1>Hello, again!</h1>

    <div class="mb-4" style="max-width: 400px;">
    <input type="text" 
           class="form-control" 
           placeholder="Caută un lightcone după nume..." 
           @bind="searchTerm" 
           @bind:event="oninput" />
    </div>

@if (lightcones == null)
{
    <p><em>Se încarcă datele...</em></p>
}
else
{
    <div class="row">
        @foreach (var l in FilteredLightcones)
        {
            <div class="col-md-4 col-sm-6 mb-4" @key="l.Id">
                <LightconeCard Lightcone="l" OnDelete="DeleteLightcone" />
            </div>
        }
        </div>
}



@code {
    private List<LightconeResponseDTO>? lightcones; 

    private string searchTerm = null!;

    private IEnumerable<LightconeResponseDTO> FilteredLightcones =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? lightcones ?? Enumerable.Empty<LightconeResponseDTO>()
            : lightcones?.Where(c => c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) 
              ?? Enumerable.Empty<LightconeResponseDTO>();

    protected override async Task OnInitializedAsync()
    {
        try
        {

            lightcones = await Http.GetFromJsonAsync<List<LightconeResponseDTO>>("http://localhost:5095/api/lightcone");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Eroare la apel API: {ex.Message}");
        }
    }

    private async Task DeleteLightcone(int id)
    {
        var response = await Http.DeleteAsync($"http://localhost:5095/api/lightcone/{id}");
        if( response.IsSuccessStatusCode)
        {
            lightcones?.RemoveAll(lc => lc.Id == id);
        }
    }

    private string GetStars(int rarity) => new string('★', rarity);

    private string GetRarityColorClass(int rarity) => rarity switch
{
    5 => "text-warning",   // Galben/Auriu
    4 => "text-primary", 
    _ => "text-secondary"  
};
}